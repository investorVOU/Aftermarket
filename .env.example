PORT=8080
HOST=127.0.0.1
APP_ORIGIN=http://localhost:8080
GAME_MODE=development
SUPABASE_URL=https://ytfioiujcitikvgbfxwg.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Server only. Percent-encode special characters in the password.
# postgresql://postgres:[YOUR-PASSWORD]@db.ytfioiujcitikvgbfxwg.supabase.co:5432/postgres
DATABASE_URL=
# rest uses HTTPS RPC with the secret key; postgres uses DATABASE_URL directly.
DATABASE_TRANSPORT=rest
SUPABASE_GOOGLE_ENABLED=false
# Optional isolated guest accounts: testnet settlement only; requires secret key.
DEMO_GUEST_ENABLED=false
DEMO_GUEST_DAILY_LIMIT=30
# Prepare at most one unused private guest session on the welcome page.
# It counts toward the daily account cap; set false to disable.
DEMO_GUEST_PREWARM=true
# Optional server-side Groq merchant dialogue and bounded business proposals.
# Disabled by default; ordinary rule-based NPCs do not need an API key.
GROQ_AGENTS_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Per-process daily cap; also set an account spend limit in the Groq console.
GROQ_DAILY_LIMIT=100
# Set GAME_MODE=connected for Supabase + NEAR. Verify on testnet before mainnet.
NEAR_NETWORK=testnet
NEAR_SETTLEMENT_ENABLED=false
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Optional private NEAR testnet fallback; never expose a credential-bearing URL.
QUICKNODE_RPC_URL=
# Stored server-side only. Endpoint authentication uses QUICKNODE_RPC_URL.
QUICKNODE_API_KEY=
NEAR_CONTRACT_ID=
# Full-access contract account key for deployment only. Keep it off the web server.
NEAR_DEPLOY_PRIVATE_KEY=
NEAR_SIGNER_ID=
NEAR_SIGNER_PRIVATE_KEY=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up. It derives the managed player and merchant wallet keys.
NEAR_WALLET_MASTER_KEY=
# Maximum attached storage deposit per checkpoint, in yoctoNEAR (0.2 NEAR).
# The contract refunds unused storage funding to the signer.
NEAR_STORAGE_DEPOSIT=200000000000000000000000
